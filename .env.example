# RAG Retrieval Service — configuration
# Copy to .env and customize.

# 服务配置
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Milvus Lite（嵌入式，无需外部服务或 Docker）
MILVUS_DATA_DIR=storage/milvus_data
MILVUS_COLLECTION_NAME=rag_collection

# 模型配置
BGE_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
DEVICE=cpu

# 向量配置
DENSE_VECTOR_DIM=1024
METRIC_TYPE=COSINE

# 检索配置
DEFAULT_TOP_K=10
SEARCH_EF=64
RRF_K=60
RERANK_TOP_K=10

# 入库配置
INGEST_BATCH_SIZE=64
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# 文件限制
MAX_FILE_SIZE=10485760
ALLOWED_EXTENTS=txt,md,docx,pdf

# PostgreSQL 元数据库
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag_retrieval
PG_USER=postgres
PG_PASSWORD=postgres

# MinIO 对象存储（原始文件）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# JWT 认证 (生产环境务必修改 JWT_SECRET 和 DEFAULT_ACCESS_KEY)
JWT_SECRET=change-me-in-production-use-env-var
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
DEFAULT_ACCESS_KEY=sk-rag-admin-00000000
